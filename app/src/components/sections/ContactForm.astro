---
/** Poptávkový formulář. Funguje bez JS (POST na Web3Forms + redirect), s JS validace + fetch. */
import { getSettings } from '../../lib/site';
const settings = await getSettings();
const redirect = new URL('/kontakt/?odeslano=1', Astro.site).toString();
const types = ['Kuchyně', 'Skříně', 'Ložnice', 'Koupelna', 'Jiné'];
const budgets = ['Do 100 000 Kč', '100 000 – 250 000 Kč', '250 000 – 500 000 Kč', 'Nad 500 000 Kč', 'Zatím nevím'];
const field = 'mt-2 block min-h-12 w-full rounded-md border border-mocha-800/25 bg-white px-4 py-3 text-ink placeholder:text-mocha-600 transition-colors focus:border-caramel-ink focus:outline-none focus:ring-2 focus:ring-caramel/50 aria-[invalid=true]:border-error';
const label = 'block text-sm font-semibold text-mocha-800';
const err = 'mt-1.5 text-sm text-[#b91c1c]';
---
<div data-contact-form>
  <div data-success role="status" aria-live="polite" tabindex="-1" class="hidden rounded-md border border-success/40 bg-white p-6 text-mocha-800">
    <h3 class="text-h3">Děkujeme, zpráva je na cestě.</h3>
    <p class="mt-2">Ozveme se vám co nejdříve, obvykle do jednoho pracovního dne.</p>
  </div>

  <form action="https://api.web3forms.com/submit" method="POST" data-form class="space-y-6" aria-label="Poptávkový formulář">
    <input type="hidden" name="access_key" value={settings.web3formsKey} />
    <input type="hidden" name="subject" value="Nová poptávka z webu KPS Interiéry" />
    <input type="hidden" name="from_name" value="Web KPS Interiéry" />
    <input type="hidden" name="redirect" value={redirect} />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="cf-name" class={label}>Jméno a příjmení <span aria-hidden="true">*</span></label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" class={field} aria-describedby="cf-name-err" />
        <p id="cf-name-err" class={err} data-err hidden></p>
      </div>
      <div>
        <label for="cf-email" class={label}>E-mail <span aria-hidden="true">*</span></label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" inputmode="email" class={field} aria-describedby="cf-email-err" />
        <p id="cf-email-err" class={err} data-err hidden></p>
      </div>
      <div>
        <label for="cf-phone" class={label}>Telefon</label>
        <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" class={field} aria-describedby="cf-phone-err" />
        <p id="cf-phone-err" class={err} data-err hidden></p>
      </div>
      <div>
        <label for="cf-location" class={label}>Lokalita realizace</label>
        <input id="cf-location" name="lokalita" type="text" autocomplete="address-level2" placeholder="např. Zlín" class={field} />
      </div>
    </div>

    <fieldset>
      <legend class={label}>Co potřebujete?</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {types.map((t) => (
          <label class="relative">
            <input type="radio" name="typ_zakazky" value={t} class="peer sr-only" />
            <span class="inline-flex min-h-11 cursor-pointer items-center rounded-full border border-mocha-800/25 bg-white px-5 text-sm font-semibold text-mocha-800 transition-colors hover:border-mocha-800 peer-checked:border-mocha-800 peer-checked:bg-mocha-800 peer-checked:text-cream peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-caramel">{t}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div>
      <label for="cf-budget" class={label}>Přibližný rozpočet</label>
      <select id="cf-budget" name="rozpocet" class={field}>
        <option value="">Nechci uvádět</option>
        {budgets.map((b) => <option value={b}>{b}</option>)}
      </select>
    </div>

    <div>
      <label for="cf-message" class={label}>Zpráva <span aria-hidden="true">*</span></label>
      <textarea id="cf-message" name="message" rows="5" required minlength="10" class={field} placeholder="Popište prostor, představy nebo termín, který máte na mysli." aria-describedby="cf-message-err"></textarea>
      <p id="cf-message-err" class={err} data-err hidden></p>
    </div>

    <div>
      <div class="flex items-start gap-3">
        <input id="cf-consent" name="souhlas" type="checkbox" value="ano" required class="mt-1 size-5 shrink-0 accent-mocha-800" aria-describedby="cf-consent-err" />
        <label for="cf-consent" class="min-h-6 text-sm text-mocha-700">Souhlasím se zpracováním osobních údajů za účelem vyřízení poptávky. <span aria-hidden="true">*</span></label>
      </div>
      <p id="cf-consent-err" class={err} data-err hidden></p>
    </div>

    <div data-error role="alert" class="hidden rounded-md border border-error/40 bg-white p-4 text-sm text-[#b91c1c]">
      Odeslání se nepovedlo. Zkuste to prosím znovu, nebo nám napište či zavolejte přímo.
    </div>

    <button type="submit" data-submit class="group inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-full bg-caramel px-8 py-3 font-semibold tracking-wide text-mocha-950 transition-colors hover:bg-caramel-light disabled:cursor-wait disabled:opacity-70 sm:w-auto">
      <span data-label>Odeslat poptávku</span>
      <span data-spinner class="hidden size-4 animate-spin rounded-full border-2 border-mocha-950/30 border-t-mocha-950" aria-hidden="true"></span>
    </button>
    <p class="text-xs text-mocha-600">Pole označená * jsou povinná.</p>
  </form>
</div>

<script>
  const MSG = {
    name: 'Vyplňte prosím své jméno.',
    email: 'Vyplňte prosím e-mail.',
    emailBad: 'Zadejte e-mail ve tvaru jmeno@domena.cz.',
    phoneBad: 'Telefon může obsahovat jen číslice, mezery a znak +.',
    message: 'Napište nám alespoň pár vět (min. 10 znaků).',
    souhlas: 'Pro odeslání je nutný souhlas se zpracováním údajů.',
  } as const;

  function setError(el: HTMLInputElement | HTMLTextAreaElement, msg: string) {
    const p = document.getElementById(el.getAttribute('aria-describedby') ?? '');
    if (!p) return;
    if (msg) { p.textContent = msg; p.hidden = false; el.setAttribute('aria-invalid', 'true'); }
    else { p.textContent = ''; p.hidden = true; el.removeAttribute('aria-invalid'); }
  }

  function validate(el: HTMLInputElement | HTMLTextAreaElement): boolean {
    let msg = '';
    const v = el.value.trim();
    switch (el.name) {
      case 'name': if (!v) msg = MSG.name; break;
      case 'email': if (!v) msg = MSG.email; else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) msg = MSG.emailBad; break;
      case 'phone': if (v && !/^[+\d][\d\s()-]{5,}$/.test(v)) msg = MSG.phoneBad; break;
      case 'message': if (v.length < 10) msg = MSG.message; break;
      case 'souhlas': if (!(el as HTMLInputElement).checked) msg = MSG.souhlas; break;
      default: return true;
    }
    setError(el, msg);
    return !msg;
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-contact-form]');
    const form = root?.querySelector<HTMLFormElement>('[data-form]');
    if (!root || !form || form.dataset.bound) return;
    form.dataset.bound = '1';
    form.noValidate = true;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const errBox = root.querySelector<HTMLElement>('[data-error]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[aria-describedby]')];

    const showSuccess = () => {
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    };

    // prefill ?typ=
    const params = new URLSearchParams(location.search);
    const typ = params.get('typ')?.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    if (typ) {
      const radios = [...form.querySelectorAll<HTMLInputElement>('input[name="typ_zakazky"]')];
      const hit = radios.find((r) => {
        const v = r.value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        return v.slice(0, 5) === typ.slice(0, 5);
      });
      if (hit) hit.checked = true;
    }
    if (params.get('odeslano') === '1') showSuccess();

    fields.forEach((f) => {
      f.addEventListener('blur', () => { if (f.value || f.getAttribute('aria-invalid')) validate(f); });
      f.addEventListener('input', () => { if (f.getAttribute('aria-invalid')) validate(f); });
      f.addEventListener('change', () => { if (f.getAttribute('aria-invalid') || f.type === 'checkbox') validate(f); });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');
      const results = fields.map(validate);
      const firstBad = fields.find((_, i) => !results[i]);
      if (firstBad) { firstBad.focus(); return; }
      const label = btn.querySelector<HTMLElement>('[data-label]')!;
      const spin = btn.querySelector<HTMLElement>('[data-spinner]')!;
      btn.disabled = true; btn.setAttribute('aria-busy', 'true');
      const prev = label.textContent; label.textContent = 'Odesílám…'; spin.classList.remove('hidden');
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        delete data.redirect;
        const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error('send');
        form.reset();
        showSuccess();
      } catch {
        errBox.classList.remove('hidden');
      } finally {
        btn.disabled = false; btn.removeAttribute('aria-busy'); label.textContent = prev; spin.classList.add('hidden');
      }
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
