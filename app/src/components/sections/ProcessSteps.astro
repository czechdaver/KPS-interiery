---
/**
 * Sdílená sekce „Spolupráce v krocích“. Použití: homepage, /o-nas/, /sluzby/.
 * variant: 'light' (krémové pozadí) | 'dark' (mocha). Nadpis i úvod lze přepsat.
 */
interface Props {
  variant?: 'light' | 'dark';
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
}
const {
  variant = 'light',
  eyebrow = 'Spolupráce v krocích',
  title = 'Od návrhu <em>po montáž</em>',
  intro = 'Celou zakázku vedeme sami – od prvního setkání až po předání hotového interiéru. Víte, co vás čeká, a máte jednoho partnera pro všechno.',
  id = 'proces',
} = Astro.props;
const dark = variant === 'dark';
const steps = [
  { n: '01', title: 'Konzultace a zaměření', text: 'Probereme vaše představy, způsob, jakým prostor používáte, i rozpočet. Pak vše přesně zaměříme přímo u vás.' },
  { n: '02', title: 'Návrh a vizualizace', text: 'Připravíme návrh s výběrem materiálů, barev a kování. Vizualizace vám ukáže výsledek dřív, než začneme vyrábět.' },
  { n: '03', title: 'Výroba v naší dílně', text: 'Každý díl vyrábíme na míru z prověřených materiálů a kování. Detaily hlídáme od řezu po finální kontrolu.' },
  { n: '04', title: 'Montáž a předání', text: 'Nábytek u vás namontujeme, seřídíme a předáme čistý a připravený k používání. Ukážeme vám, jak o něj pečovat.' },
];
const headingId = `${id}-title`;
---
<section id={id} aria-labelledby={headingId} class:list={['section-y', dark ? 'on-dark bg-mocha-900 text-cream/80' : 'bg-cream text-ink']}>
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-5" data-reveal>{eyebrow}</p>
        <h2 id={headingId} class:list={['text-h1 font-light', dark ? '!text-cream' : '']} data-reveal style="--reveal-i:1" set:html={title} />
      </div>
      {intro && (
        <p class:list={['text-lead lg:col-span-5 lg:pb-2', dark ? 'text-cream/80' : 'text-mocha-700']} data-reveal style="--reveal-i:2">{intro}</p>
      )}
    </div>

    <ol class="process-list mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4" role="list">
      {steps.map((s, i) => (
        <li class:list={['process-step relative border-t pt-8', dark ? 'border-white/15' : 'border-mocha-800/15']} data-reveal style={`--reveal-i:${i}`}>
          <span class:list={['process-line absolute -top-px left-0 h-px w-full origin-left', dark ? 'bg-caramel' : 'bg-caramel-ink']} aria-hidden="true"></span>
          <span class:list={['block font-display text-[clamp(3.5rem,2.5rem+3vw,5.5rem)] font-light leading-none tracking-tight', dark ? 'text-caramel' : 'text-caramel-ink']} aria-hidden="true">{s.n}</span>
          <h3 class:list={['mt-6 text-h3', dark ? '!text-cream' : '']}><span class="sr-only">Krok {i + 1}: </span>{s.title}</h3>
          <p class:list={['mt-3 max-w-sm', dark ? 'text-cream/75' : 'text-mocha-700']}>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  h2 :global(em) { font-style: italic; color: var(--color-caramel-ink); }
  .on-dark h2 :global(em) { color: var(--color-caramel); }
  .process-line { transform: scaleX(0); }
  :global(html:not(.js)) .process-line,
  .process-step:global(.is-revealed) .process-line {
    transform: scaleX(1);
    transition: transform 1.4s var(--ease-out-expo) calc(var(--reveal-i, 0) * 120ms + 200ms);
  }
  @media (prefers-reduced-motion: reduce) { .process-line { transform: scaleX(1); } }
</style>
