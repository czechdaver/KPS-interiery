---
/** Manifest K·P·S – zkratka jako velký typografický moment + statistiky z nastavení. */
import { getSettings } from '../../lib/site';
const s = await getSettings();
const values = [
  { l: 'K', word: 'Kvalita', text: 'Pracujeme s prověřenými materiály a kováním od výrobců, kterým věříme. Nábytek má sloužit roky, ne sezónu.' },
  { l: 'P', word: 'Preciznost', text: 'Každý kus zaměřujeme a vyrábíme přesně pro váš prostor. Hlídáme spáry, hrany a detaily, které na první pohled nevidíte.' },
  { l: 'S', word: 'Spokojenost', text: 'Zakázku vedeme od prvního nákresu po montáž. Hotovo je ve chvíli, kdy jste spokojení vy – ne dřív.' },
];
---
<section id="manifest" class="section-y relative overflow-hidden bg-cream-50" aria-labelledby="manifest-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12">
      <p class="eyebrow lg:col-span-3 lg:pt-4" data-reveal>Naše hodnoty</p>
      <h2 id="manifest-title" class="manifest-title text-h1 font-light lg:col-span-9" data-reveal style="--reveal-i:1">
        Za každou kuchyní stojí tři <em>sliby</em>. Nosíme je přímo v&nbsp;našem jménu.
      </h2>
    </div>

    <ol class="mt-16 grid border-t border-mocha-800/15 lg:mt-24 lg:grid-cols-3" role="list">
      {values.map((v, i) => (
        <li class:list={['kps-item group relative grid grid-cols-[auto_1fr] gap-x-6 border-b border-mocha-800/15 py-10 sm:gap-x-10 lg:block lg:border-b-0 lg:px-10 lg:py-14', i > 0 && 'lg:border-l', i === 0 && 'lg:pl-0', i === 2 && 'lg:pr-0']} data-reveal style={`--reveal-i:${i}`}>
          <span class="kps-letter row-span-2 block font-display font-light leading-[0.8] text-mocha-800" aria-hidden="true">{v.l}</span>
          <h3 class="self-end text-h3 lg:mt-10"><span class="text-caramel-ink">{v.word.charAt(0)}</span>{v.word.slice(1)}</h3>
          <p class="mt-3 max-w-sm text-mocha-700">{v.text}</p>
        </li>
      ))}
    </ol>

    {s.stats.length > 0 && (
      <dl class="mt-16 grid gap-10 sm:grid-cols-3 lg:mt-20">
        {s.stats.map((st, i) => (
          <div class="flex flex-col-reverse gap-2 border-l border-caramel-ink/40 pl-6" data-reveal style={`--reveal-i:${i}`}>
            <dt class="text-sm font-semibold uppercase tracking-[0.14em] text-mocha-700">{st.label}</dt>
            <dd class="font-display text-[clamp(2.75rem,2rem+3vw,4.5rem)] font-light leading-none tracking-tight text-mocha-800">{st.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .manifest-title :global(em) { font-style: italic; color: var(--color-caramel-ink); }
  .kps-letter {
    font-size: clamp(6rem, 3rem + 14vw, 15rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    letter-spacing: -0.04em;
    transition: color 0.8s var(--ease-out-expo), transform 1.2s var(--ease-out-expo);
  }
  .kps-item:hover .kps-letter { color: var(--color-caramel-ink); transform: translateY(-6px); }
  @media (max-width: 1023px) { .kps-letter { font-size: clamp(5.5rem, 3rem + 14vw, 9rem); } }
</style>
