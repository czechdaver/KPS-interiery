---
/**
 * Služby: interaktivní seznam. Desktop: hover/focus na službu prolne náhled (cover první navázané realizace).
 * Mobil: skládané karty s fotkou. Každá služba vede na kategorii realizací.
 */
import { Picture } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import { categorySlug } from '../../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(
  services.map(async (sv) => {
    const first = sv.data.projects[0] ? await getEntry(sv.data.projects[0]) : undefined;
    return {
      id: sv.id,
      ...sv.data,
      href: `/realizace/kategorie/${categorySlug(sv.data.category ?? 'Ostatní')}/`,
      image: first?.data.cover,
      alt: first ? (first.data.images[0]?.alt ?? first.data.title) : '',
    };
  }),
);
---
<section class="section-y bg-cream" aria-labelledby="services-title" data-services>
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-5" data-reveal>Co pro vás vyrobíme</p>
        <h2 id="services-title" class="services-title text-h1 font-light" data-reveal style="--reveal-i:1">Celý interiér <em>z jedné dílny</em></h2>
      </div>
      <div class="flex flex-col gap-6 lg:col-span-5 lg:items-start" data-reveal style="--reveal-i:2">
        <p class="text-lead text-mocha-700">Kuchyně jsou naše srdcovka, ale na míru vyrobíme i skříně, ložnice, koupelny a atypické kusy. Vše ladí materiálově i tvarově.</p>
        <Button href="/sluzby/" variant="link" arrow>Všechny služby</Button>
      </div>
    </div>

    <div class="mt-14 grid gap-10 lg:mt-20 lg:grid-cols-12 lg:gap-16">
      <ul class="lg:col-span-7" role="list">
        {items.map((it, i) => (
          <li class="border-t border-mocha-800/15 last:border-b" data-reveal style={`--reveal-i:${i}`}>
            <a href={it.href} class="service-row group grid grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-4 py-6 sm:gap-x-8 lg:py-8" data-service={i} data-active={i === 0 ? 'true' : undefined}>
              {it.image && (
                <div class="col-span-3 overflow-hidden rounded-md bg-linen lg:hidden">
                  <Picture fallbackFormat="webp" src={it.image} alt="" formats={['avif']} widths={[480, 720, 960]} sizes="(min-width: 640px) 90vw, 100vw" layout="full-width" loading="lazy" class="aspect-[16/10] h-full w-full object-cover" />
                </div>
              )}
              <span class="service-icon grid size-12 place-items-center rounded-full border border-mocha-800/20 text-mocha-800 transition-colors duration-500 sm:size-14" aria-hidden="true">
                <Icon name={it.icon} class="size-6 sm:size-7" />
              </span>
              <div class="min-w-0">
                <div class="flex items-baseline gap-3">
                  <span class="hidden font-display text-sm tabular-nums text-caramel-ink sm:inline" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="service-name text-h3 transition-colors duration-500">{it.title}</h3>
                </div>
                <p class="mt-1 text-mocha-700">{it.short}</p>
              </div>
              <span class="service-arrow grid size-11 place-items-center rounded-full text-mocha-800 transition-all duration-500" aria-hidden="true">
                <Icon name="ph:arrow-up-right-light" class="size-6" />
              </span>
              <span class="sr-only">– realizace v kategorii {it.category ?? 'Ostatní'}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="relative hidden lg:col-span-5 lg:block">
        <div class="sticky top-[calc(var(--header-h)+2rem)] aspect-[4/5] overflow-hidden rounded-lg bg-linen" aria-hidden="true">
          {items.map((it, i) => it.image && (
            <div class:list={['service-preview absolute inset-0', i === 0 && 'is-active']} data-preview={i}>
              <Picture fallbackFormat="webp" src={it.image} alt="" formats={['avif']} widths={[640, 960, 1200]} sizes="(min-width: 1440px) 560px, 38vw" layout="full-width" loading="lazy" class="h-full w-full object-cover" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-mocha-950/80 to-transparent p-6 pt-20">
                <p class="font-display text-h3 text-cream">{it.title}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-title :global(em) { font-style: italic; color: var(--color-caramel-ink); }
  .service-preview { opacity: 0; transform: scale(1.06); transition: opacity 0.9s var(--ease-out-expo), transform 1.4s var(--ease-out-expo); }
  .service-preview.is-active { opacity: 1; transform: none; z-index: 1; }
  .service-preview :global(picture) { display: block; height: 100%; }
  .service-preview :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .service-row:hover .service-arrow, .service-row:focus-visible .service-arrow { background: var(--color-mocha-800); color: var(--color-cream); transform: rotate(45deg); }
  .service-row:hover .service-icon, .service-row:focus-visible .service-icon { background: var(--color-caramel); border-color: var(--color-caramel); color: var(--color-mocha-950); }
  @media (min-width: 1024px) {
    .service-row .service-name { color: color-mix(in srgb, var(--color-mocha-800) 70%, var(--color-cream)); }
    .service-row[data-active='true'] .service-name, .service-row:hover .service-name { color: var(--color-mocha-800); }
    .service-row { transition: padding 0.7s var(--ease-out-expo); }
    .service-row[data-active='true'] { padding-left: 1rem; }
    .service-row[data-active='true'] .service-arrow { background: var(--color-mocha-800); color: var(--color-cream); transform: rotate(45deg); }
  }
</style>

<script>
  let ctrl: AbortController | null = null;
  function init() {
    ctrl?.abort();
    ctrl = null;
    const root = document.querySelector<HTMLElement>('[data-services]');
    if (!root) return;
    ctrl = new AbortController();
    const { signal } = ctrl;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-service]')];
    const previews = [...root.querySelectorAll<HTMLElement>('[data-preview]')];
    const activate = (i: number) => {
      rows.forEach((r, j) => (j === i ? r.setAttribute('data-active', 'true') : r.removeAttribute('data-active')));
      previews.forEach((p) => p.classList.toggle('is-active', Number(p.dataset.preview) === i));
      // přednačti náhled
      previews.find((p) => Number(p.dataset.preview) === i)?.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
    };
    rows.forEach((r, i) => {
      r.addEventListener('pointerenter', () => activate(i), { signal });
      r.addEventListener('focus', () => activate(i), { signal });
    });
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { ctrl?.abort(); ctrl = null; });
</script>
