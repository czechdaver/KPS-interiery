---
/** Karta realizace – sdílená homepage + /realizace. size: 'lg' = featured, 'md' = grid. */
import { Picture } from 'astro:assets';
import type { Project } from '../../lib/site';
import { formatMonth } from '../../lib/site';
interface Props { project: Project; size?: 'lg' | 'md'; eager?: boolean; sizes?: string; index?: number }
const { project, size = 'md', eager = false, index = 0, sizes = size === 'lg' ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' } = Astro.props;
const d = project.data;
---
<article class="group relative" data-reveal style={`--reveal-i:${index % 6}`} data-category={d.category}>
  <a href={`/realizace/${project.id}/`} class="block focus-visible:outline-offset-4" aria-label={`${d.title} – ${d.location}`}>
    <div class:list={['relative overflow-hidden rounded-md bg-linen', size === 'lg' ? 'aspect-[4/3] lg:aspect-[16/10]' : 'aspect-[4/5]']}>
      <Picture
        src={d.cover}
        alt={d.images[0]?.alt ?? d.title}
        formats={['avif', 'webp']}
        widths={size === 'lg' ? [640, 960, 1280, 1600, 2000] : [400, 640, 800, 1000]}
        sizes={sizes}
        layout="full-width"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
        transition:name={`cover-${project.id}`}
      />
      <span class="absolute left-4 top-4 rounded-full bg-cream/90 px-3 py-1 text-xs font-semibold text-mocha-800 backdrop-blur">{d.category}</span>
    </div>
    <div class="mt-4 flex items-baseline justify-between gap-4">
      <h3 class:list={['font-display text-mocha-800', size === 'lg' ? 'text-h3' : 'text-xl']}>{d.title}</h3>
      <span class="shrink-0 text-sm text-mocha-600">{d.images.length} foto</span>
    </div>
    <p class="mt-1 text-sm text-mocha-600">{d.location} · {formatMonth(d.date)}</p>
  </a>
</article>
