---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import Seo from '../components/layout/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Header přes tmavý hero (průhledný, světlé logo) */
  headerOverlay?: boolean;
}
const { headerOverlay = false, ...seo } = Astro.props;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2a1a17" />
    <link rel="icon" href="/branding/fav.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Seo {...seo} />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-mocha-800 focus:px-4 focus:py-2 focus:text-cream">Přeskočit na obsah</a>
    <Header overlay={headerOverlay} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotion } from '../lib/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
