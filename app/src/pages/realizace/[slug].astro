---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/gallery/ProjectGallery.astro';
import ProjectPager from '../../components/gallery/ProjectPager.astro';
import ProjectGrid from '../../components/gallery/ProjectGrid.astro';
import CtaBand from '../../components/gallery/CtaBand.astro';
import { buildGallery, dominantColor, fitWidths, pad2 } from '../../components/gallery/data';
import { copyFor } from '../../components/gallery/categories';
import { fotoLabel } from '../../components/gallery/format';
import { categorySlug, formatMonth, getProjects, getSettings, type Project } from '../../lib/site';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
      all: projects,
    },
  }));
}) satisfies GetStaticPaths;

interface Props { project: Project; prev: Project; next: Project; all: Project[] }
const { project, prev, next, all } = Astro.props;
const d = project.data;
const settings = await getSettings();
const slug = categorySlug(d.category);
const copy = copyFor(slug);

const images = await buildGallery(d.images);
// Porovnání přes fsPath – přístup k `.src` by do buildu zkopíroval originál.
const fsOf = (m: unknown) => (m as { fsPath?: string }).fsPath;
const coverIndex = d.images.findIndex((im) => fsOf(im.src) === fsOf(d.cover));
const heroColor = await dominantColor(d.cover);
const heroTarget = coverIndex >= 0 ? coverIndex : 0;
const heroAlt = coverIndex >= 0 ? d.images[coverIndex].alt : d.images[0]?.alt ?? d.title;

const sameCat = all.filter((p) => p.id !== project.id && p.data.category === d.category);
const others = all.filter((p) => p.id !== project.id && p.data.category !== d.category);
const related = [...sameCat, ...others].slice(0, 3);

// seoText → čitelné odstavce (po ~3 větách)
const sentences = d.seoText.match(/[^.!?]+[.!?]+(\s|$)/g)?.map((s) => s.trim()) ?? (d.seoText ? [d.seoText] : []);
const paragraphs: string[] = [];
for (let i = 0; i < sentences.length; i += 3) paragraphs.push(sentences.slice(i, i + 3).join(' '));

const site = Astro.site!;
const url = new URL(`/realizace/${project.id}/`, site).href;
const catUrl = new URL(`/realizace/kategorie/${slug}/`, site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['ImageGallery', 'CreativeWork'],
    name: d.title,
    headline: d.title,
    description: d.description,
    url,
    inLanguage: 'cs',
    dateCreated: d.date,
    genre: d.category,
    keywords: [d.category, ...d.materials].join(', '),
    ...(d.location ? { locationCreated: { '@type': 'Place', name: d.location } } : {}),
    creator: { '@type': 'Organization', name: settings.company, url: site.href, telephone: settings.phone },
    isPartOf: { '@type': 'CollectionPage', name: 'Realizace', url: new URL('/realizace/', site).href },
    numberOfItems: images.length,
    image: images.map((im) => ({
      '@type': 'ImageObject',
      contentUrl: new URL(im.lightbox.src, site).href,
      width: im.lightbox.width,
      height: im.lightbox.height,
      caption: im.caption || im.alt,
      name: im.alt,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Úvod', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Realizace', item: new URL('/realizace/', site).href },
      { '@type': 'ListItem', position: 3, name: d.category, item: catUrl },
      { '@type': 'ListItem', position: 4, name: d.title, item: url },
    ],
  },
];
const meta = [
  { k: 'Kategorie', v: d.category, href: `/realizace/kategorie/${slug}/` },
  ...(d.location ? [{ k: 'Lokalita', v: d.location }] : []),
  { k: 'Realizováno', v: formatMonth(d.date) },
  { k: 'Fotografie', v: fotoLabel(images.length) },
] as { k: string; v: string; href?: string }[];
---
<BaseLayout
  title={`${d.title}${d.location ? ` – ${d.location}` : ''} | Realizace`}
  description={d.description}
  image={d.cover}
  schema={schema}
  headerOverlay
>
  <!-- HERO -->
  <section class="pd-hero on-dark relative isolate flex flex-col justify-end overflow-hidden bg-mocha-950 text-cream" style={heroColor ? `background-color:${heroColor}` : undefined}>
    <a
      href={images[heroTarget]?.lightbox.src}
      data-pswp-hero
      data-pswp-index={heroTarget}
      data-astro-reload
      data-astro-prefetch="false"
      tabindex="-1"
      aria-hidden="true"
      class="absolute inset-0 -z-10 block cursor-zoom-in"
    >
      <Picture fallbackFormat="webp"
        src={d.cover}
        alt={heroAlt}
        formats={['avif']}
        widths={fitWidths([640, 960, 1280, 1600, 2400], d.cover)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="pd-hero-img h-full w-full object-cover"
        transition:name={`cover-${project.id}`}
      />
    </a>
    <div aria-hidden="true" class="pd-hero-shade pointer-events-none absolute inset-0 -z-10"></div>

    <div class="container-x pointer-events-none relative pb-8 pt-[calc(var(--header-h)+4rem)] md:pb-12">
      <nav aria-label="Drobečková navigace" class="pointer-events-auto text-sm text-cream/80">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/realizace/" class="inline-flex min-h-11 items-center underline-offset-4 hover:text-cream hover:underline">Realizace</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`/realizace/kategorie/${slug}/`} class="inline-flex min-h-11 items-center underline-offset-4 hover:text-cream hover:underline">{d.category}</a></li>
        </ol>
      </nav>
      <h1 class="pd-title mt-3 max-w-5xl text-display text-cream">{d.title}</h1>

      <div class="mt-10 flex flex-col gap-8 border-t border-white/15 pt-6 md:mt-14 lg:flex-row lg:items-end lg:justify-between">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-4 lg:gap-x-14">
          {meta.map((m) => (
            <div>
              <dt class="text-[0.6875rem] font-semibold uppercase tracking-[0.2em] text-caramel">{m.k}</dt>
              <dd class="mt-1.5 text-base text-cream">
                {m.href ? <a href={m.href} class="pointer-events-auto underline decoration-white/30 underline-offset-4 hover:decoration-caramel">{m.v}</a> : m.v}
              </dd>
            </div>
          ))}
        </dl>
        <a
          href={images[heroTarget]?.lightbox.src}
          data-pswp-index={heroTarget}
          data-astro-reload
          data-astro-prefetch="false"
          class="pointer-events-auto inline-flex min-h-11 items-center gap-3 self-start rounded-full border border-cream/30 px-6 py-3 font-semibold text-cream transition-colors duration-300 hover:border-cream hover:bg-cream hover:text-mocha-900 lg:self-auto"
        >
          <Icon name="ph:images-light" class="size-5" aria-hidden="true" />
          Prohlédnout fotografie
        </a>
      </div>
    </div>
  </section>

  <!-- O REALIZACI + SPECIFIKACE -->
  <section class="section-y bg-cream-50" aria-labelledby="about-title">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <h2 id="about-title" class="eyebrow" data-reveal>O realizaci</h2>
        <p class="mt-6 font-display text-h3 font-light text-mocha-800" data-reveal style="--reveal-i:1">{d.description}</p>
      </div>
      {(d.features.length > 0 || d.materials.length > 0) && (
        <div class="grid gap-12 sm:grid-cols-2 sm:gap-10 lg:col-span-6 lg:col-start-7">
          {[
            { title: 'Co jsme řešili', list: d.features },
            { title: 'Materiály a kování', list: d.materials },
          ]
            .filter((g) => g.list.length > 0)
            .map((g, gi) => (
              <div data-reveal style={`--reveal-i:${gi + 1}`}>
                <h3 class="font-sans text-xs font-bold uppercase tracking-[0.22em] text-mocha-600">{g.title}</h3>
                <ol class="mt-5 border-t border-mocha-800/15" role="list">
                  {g.list.map((item, k) => (
                    <li class="flex gap-4 border-b border-linen py-3.5 text-mocha-800">
                      <span class="w-6 shrink-0 pt-0.5 text-xs font-semibold tabular-nums text-caramel-ink">{pad2(k + 1)}</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
        </div>
      )}
    </div>
  </section>

  <!-- GALERIE -->
  <div class="bg-cream-50">
    <ProjectGallery images={images} title={d.title} skipIndex={coverIndex} />
  </div>

  <!-- SEO TEXT -->
  {paragraphs.length > 0 && (
    <section class="section-y bg-cream" aria-labelledby="detail-title">
      <div class="container-x grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
            <p class="eyebrow">Podrobněji</p>
            <h2 id="detail-title" class="mt-4 text-h2">{d.title} <em class="font-light italic text-caramel-ink">v detailu</em></h2>
          </div>
        </div>
        <div class="pd-prose max-w-[68ch] lg:col-span-7 lg:col-start-6">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  <ProjectPager prev={prev} next={next} />

  <!-- DALŠÍ REALIZACE -->
  {related.length > 0 && (
    <section class="section-y bg-cream-50" aria-labelledby="related-title">
      <div class="container-x">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-6 md:mb-14">
          <div>
            <p class="eyebrow">{sameCat.length > 0 ? d.category : 'Realizace'}</p>
            <h2 id="related-title" class="mt-3 text-h2">Další realizace</h2>
          </div>
          <a href={sameCat.length > 0 ? `/realizace/kategorie/${slug}/` : '/realizace/'} class="group inline-flex min-h-11 items-center gap-3 font-semibold text-mocha-800 decoration-caramel underline-offset-[6px] hover:underline">
            {sameCat.length > 0 ? `Vše v kategorii ${d.category}` : 'Všechny realizace'}
            <Icon name="ph:arrow-right-light" class="size-5 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
          </a>
        </div>
        <ProjectGrid projects={related} />
      </div>
    </section>
  )}

  <CtaBand heading={copy.cta} lead={copy.ctaLead} />
</BaseLayout>

<style>
  .pd-hero {
    min-height: max(560px, 100svh);
  }
  @media (min-width: 1024px) {
    .pd-hero { min-height: clamp(640px, 100svh, 1100px); }
  }
  .pd-hero-shade {
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--color-mocha-950) 55%, transparent) 0%, transparent 22%),
      linear-gradient(to top, color-mix(in srgb, var(--color-mocha-950) 88%, transparent) 0%, color-mix(in srgb, var(--color-mocha-950) 45%, transparent) 38%, transparent 70%);
  }
  .pd-title { text-shadow: 0 2px 30px color-mix(in srgb, var(--color-mocha-950) 35%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .pd-hero-img { animation: pd-zoom 2.4s var(--ease-out-expo) both; }
    @keyframes pd-zoom { from { transform: scale(1.06); } }
  }
  .pd-prose p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink);
  }
  .pd-prose p + p { margin-top: 1.4em; }
  .pd-prose p:first-child {
    font-size: var(--text-lead);
    color: var(--color-mocha-800);
  }
  .pd-prose p:first-child::first-letter {
    float: left;
    margin: 0.08em 0.12em 0 0;
    font-family: var(--font-display);
    font-size: 3.6em;
    line-height: 0.8;
    font-weight: 300;
    color: var(--color-caramel-ink);
  }
</style>
